<resources>
    <color name="paper">#F7F7F2</color>
    <style name="Theme.Offscript" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.Offscript.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Offscript</item>
    </style>
    <string name="app_name">offscript</string>
</resources>
