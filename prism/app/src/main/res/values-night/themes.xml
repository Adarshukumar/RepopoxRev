<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Prism" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Prism.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/prism_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Prism</item>
    </style>

</resources>
