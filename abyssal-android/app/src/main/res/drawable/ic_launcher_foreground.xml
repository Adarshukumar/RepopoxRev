<?xml version="1.0" encoding="utf-8"?>
<!--
  A descent, drawn in three marks that stay legible at 48dp:
  the swell at the surface, the line of the drop, and the anglerfish lure at the
  bottom - the only light down there, and the one shape in the app that everybody
  recognises. The lure uses the same #FFCF6B the canvas lights it with.

  Everything sits inside the central 72dp safe zone (x,y from 18 to 90) so no
  launcher mask can crop it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- surface swell -->
    <path
        android:pathData="M28,30 C35,26 41,34 48,30 C55,26 61,34 68,30 C73,27.5 77,30 81,29"
        android:strokeColor="#BFEAFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeAlpha="0.95"
        android:fillColor="#00000000" />

    <!-- the drop: a line that breaks into dashes as the light runs out -->
    <path
        android:pathData="M54.5,38 L54.5,58"
        android:strokeColor="#9FF3FF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M54.5,63.5 L54.5,67.5"
        android:strokeColor="#9FF3FF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeAlpha="0.7"
        android:fillColor="#00000000" />

    <!-- halo, then the lure itself -->
    <path
        android:pathData="M54.5,77.5 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0"
        android:fillColor="#FFCF6B"
        android:fillAlpha="0.22" />
    <path
        android:pathData="M54.5,77.5 m-4.6,0 a4.6,4.6 0 1,0 9.2,0 a4.6,4.6 0 1,0 -9.2,0"
        android:fillColor="#FFCF6B" />
</vector>
