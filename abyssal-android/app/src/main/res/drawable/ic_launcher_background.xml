<?xml version="1.0" encoding="utf-8"?>
<!--
  The background is the water column itself, and it uses the same colour stops that
  js/data.js feeds the canvas: #0E6D97 where the sunlight zone gives out, #03253F at
  the base of the twilight zone, #00050A in the abyss. So the icon and the app agree
  about what the ocean looks like, rather than the icon being a separate guess.

  108dp viewport; adaptive icons mask the outer 18dp on every side.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="0"
                android:endX="54" android:endY="108">
                <item android:offset="0.00" android:color="#FF0E6D97" />
                <item android:offset="0.42" android:color="#FF03253F" />
                <item android:offset="1.00" android:color="#FF00050A" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
