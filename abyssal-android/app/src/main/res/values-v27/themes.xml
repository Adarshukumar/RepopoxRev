<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowLayoutInDisplayCutoutMode was added in API 27, so it lives in a
         version-qualified overlay rather than in the base theme. Drawing into the
         cutout matters here: the canvas is the whole app, and a letterboxed ocean
         reads as a broken one. -->
    <style name="Theme.Abyssal" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/abyss_backdrop</item>
        <item name="android:statusBarColor">@color/abyss_backdrop</item>
        <item name="android:navigationBarColor">@color/abyss_backdrop</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
