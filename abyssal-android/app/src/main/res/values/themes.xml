<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A framework theme, not an AppCompat one: there is no AndroidX in this build.
         The window background matches the canvas at depth so there is no white flash
         in the moment before the WebView paints its first frame. -->
    <style name="Theme.Abyssal" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/abyss_backdrop</item>
        <item name="android:statusBarColor">@color/abyss_backdrop</item>
        <item name="android:navigationBarColor">@color/abyss_backdrop</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
