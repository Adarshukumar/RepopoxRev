<?xml version="1.0" encoding="utf-8"?>
<!--
  ABYSSAL for Android — manifest

  There is no <uses-permission> element in this file, and that is the point: the app
  requests no INTERNET permission, so the installed APK has no mechanism by which it
  could make a network request. It is offline because it cannot be otherwise, not
  because it promises to be.

  It also declares no analytics, no ads ID, no storage and no location. Everything
  the descent needs is drawn or synthesised at runtime from data compiled into the
  APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/app_description"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.Abyssal">

        <!-- android:configChanges is load-bearing. Without it, rotating the device
             destroys and recreates the Activity, which destroys the WebView, which
             throws away the descent. The page is already responsive, so handling the
             change here means it simply relayouts. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/Theme.Abyssal"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
