{
  "manifest_version": 2,
  "name": "Frame CI playback observer (test-only activation)",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "frame-evidence@test.invalid"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent"],
  "content_scripts": [{"matches": ["https://*.youtube.com/*"], "js": ["observe.js"], "run_at": "document_idle"}]
}
