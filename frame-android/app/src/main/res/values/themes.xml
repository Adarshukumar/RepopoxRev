<resources>
    <color name="background">#111B19</color>
    <style name="Theme.Frame" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Frame.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/frame_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Frame</item>
    </style>
</resources>
